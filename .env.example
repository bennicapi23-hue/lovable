# =============================================================================
# Kiln configuration
#
# Copy to .env.local and fill in. Run `pnpm check:env` at any point — it
# reports what is configured, what is missing, and the fix for each gap.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LANGUAGE MODEL — required, at least one
# -----------------------------------------------------------------------------
# Easiest: one gateway key covers every provider below.
AI_GATEWAY_API_KEY=            # https://vercel.com/dashboard/ai-gateway/api-keys

# Or bring individual provider keys. Used when AI_GATEWAY_API_KEY is unset.
ANTHROPIC_API_KEY=             # https://console.anthropic.com
OPENAI_API_KEY=                # https://platform.openai.com
GEMINI_API_KEY=                # https://aistudio.google.com/app/apikey
GROQ_API_KEY=                  # https://console.groq.com

# -----------------------------------------------------------------------------
# 2. SANDBOX — required. Where generated apps actually run.
#    Choose ONE provider.
# -----------------------------------------------------------------------------
SANDBOX_PROVIDER=vercel        # vercel | e2b

# --- Option A: Vercel (default) ---
# Easiest for local development: `vercel link && vercel env pull` writes this.
VERCEL_OIDC_TOKEN=

# For production, or where OIDC is unavailable. All three are required together
# — a partially filled set is the most common way to get this wrong.
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# --- Option B: E2B ---
# Set SANDBOX_PROVIDER=e2b above, then:
# E2B_API_KEY=                 # https://e2b.dev

# -----------------------------------------------------------------------------
# 3. URL REBUILD — optional
#    Needed only to rebuild an existing site. Building an app from a
#    description works without it.
# -----------------------------------------------------------------------------
FIRECRAWL_API_KEY=             # https://firecrawl.dev

# -----------------------------------------------------------------------------
# 4. FASTER EDITS — optional
#    Applies follow-up edits as diffs rather than whole files.
# -----------------------------------------------------------------------------
MORPH_API_KEY=                 # https://morphllm.com

# -----------------------------------------------------------------------------
# 5. COMMERCIAL — optional
#    Plan every caller resolves to until real auth and billing are wired into
#    lib/billing/entitlements.ts. See config/plans.config.ts for the plans.
# -----------------------------------------------------------------------------
KILN_DEFAULT_PLAN=free         # free | pro | team | enterprise
